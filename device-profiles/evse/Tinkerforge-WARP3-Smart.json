{
  "schema": "opendtu-hems-modbus-profile/v2",
  "id": "tinkerforge.warp3-smart",
  "capabilities": ["evse"],
  "metadata": {
    "vendor": "Tinkerforge",
    "model": "WARP3 Smart",
    "source": "Official Tinkerforge WARP Charger Modbus implementation",
    "source_revision": "73949ffd83ec9073b8c38caf2b99a64d5a151858",
    "description": "Vendor-documented WARP3 Smart telemetry and optional Modbus current control"
  },
  "provenance": {
    "author": "Tinkerforge documentation/source; OpenDTU-HEMS adaptation",
    "license": "Profile adaptation GPL-2.0-or-later; upstream documentation/source cited"
  },
  "transport": {
    "protocol": "modbus_tcp",
    "default_port": 502,
    "unit_id": 1,
    "address_base": 0
  },
  "telemetry": [
    {
      "key": "register_table_version",
      "space": "input",
      "address": 0,
      "count": 2,
      "type": "uint32",
      "min": 2,
      "max": 5
    },
    {
      "key": "uptime_s",
      "space": "input",
      "address": 12,
      "count": 2,
      "type": "uint32",
      "unit": "s",
      "min": 0
    },
    {
      "key": "iec_state",
      "space": "input",
      "address": 1000,
      "count": 2,
      "type": "uint32",
      "min": 0,
      "max": 4
    },
    {
      "key": "charging_state",
      "space": "input",
      "address": 1002,
      "count": 2,
      "type": "uint32",
      "min": 0,
      "max": 4
    },
    {
      "key": "allowed_current_a",
      "space": "input",
      "address": 1010,
      "count": 2,
      "type": "uint32",
      "scale": 0.001,
      "unit": "A",
      "min": 0,
      "max": 32
    }
  ],
  "control": {
    "operations": [
      {
        "key": "set_current_a",
        "input": {
          "unit": "A",
          "min": 6,
          "max": 32,
          "step": 1
        },
        "writes": [
          {
            "address": 1000,
            "type": "uint16",
            "value": "input"
          }
        ]
      },
      {
        "key": "stop_charging",
        "writes": [
          {
            "address": 1000,
            "type": "uint16",
            "value": 0
          }
        ]
      }
    ]
  }
}
